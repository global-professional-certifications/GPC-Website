{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "sanity": "sanity dev",
    "sanity:deploy": "sanity deploy",
    "// migration": "Vite build kept runnable as a local rollback target until the Next.js deployment is confirmed stable. Remove with vite.config.js and index.html at cleanup.",
    "dev:vite": "vite",
    "build:vite": "vite build",
    "preview:vite": "vite preview",
    "// verification": "Freeze current URL behaviour, then diff a candidate deployment against it.",
    "baseline:prod": "node migration/capture-baseline.js --base https://globalprofessionalcertifications.com --out migration/baseline/prod.json",
    "baseline:local": "node migration/capture-baseline.js --base http://localhost:3000 --out migration/baseline/next-local.json",
    "verify": "node migration/compare.js migration/baseline/prod.json migration/baseline/next-local.json"
  },
